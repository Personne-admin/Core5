
HOST_TOOLS_WORK_ROOT	:= $(WORK_ROOT)$(PATH_SEPARATOR)Host Tools$(PATH_SEPARATOR)$(HOST)
HOST_PLATFORM_ROOT		:= $(TOOLS_ROOT)$(PATH_SEPARATOR)Platform$(PATH_SEPARATOR)$(HOST)

INSTALL_FAT_BOOT_FILE_ROOT		:= $(TOOLS_ROOT)$(PATH_SEPARATOR)Install FAT Boot File
INSTALL_FAT_BOOT_FILE_SRC_ROOT	:= $(INSTALL_FAT_BOOT_FILE_ROOT)$(PATH_SEPARATOR)Source
INSTALL_FAT_BOOT_FILE_DC_ENTRY	:= $(INSTALL_FAT_BOOT_FILE_SRC_ROOT)$(PATH_SEPARATOR)Main.dc

INSTALL_FAT_BOOT_FILE			:= $(HOST_TOOLS_WORK_ROOT)$(PATH_SEPARATOR)Install FAT Boot File
INSTALL_FAT_BOOT_FILE_DEP		:= $(HOST_TOOLS_WORK_ROOT)$(PATH_SEPARATOR)Install FAT Boot File.d
INSTALL_FAT_BOOT_FILE_COMPDB	:= $(HOST_TOOLS_WORK_ROOT)$(PATH_SEPARATOR)Install FAT Boot File.compdb.json

eINSTALL_FAT_BOOT_FILE_DC_ENTRY	:= $(call escape_path,$(INSTALL_FAT_BOOT_FILE_DC_ENTRY))
eINSTALL_FAT_BOOT_FILE			:= $(call escape_path,$(INSTALL_FAT_BOOT_FILE))
eINSTALL_FAT_BOOT_FILE_DEP		:= $(call escape_path,$(INSTALL_FAT_BOOT_FILE_DEP))
eINSTALL_FAT_BOOT_FILE_COMPDB	:= $(call escape_path,$(INSTALL_FAT_BOOT_FILE_COMPDB))

eCOMPDB_ENTRIES					+= $(eINSTALL_FAT_BOOT_FILE_COMPDB)

HOST_TOOLS_DCC_FLAGS := \
						-fpartial-eval \
						-fwhole-program \
						-I"$(HOST_PLATFORM_ROOT)"

ifeq ($(HOST),Linux)
    HOST_TOOLS_DCC_FLAGS += -target x86_64-elf
endif

ifeq ($(CONFIG),Debug)
    HOST_TOOLS_DCC_FLAGS += -fbounds-check -frestricted-check -J"using bool DEBUG = true;"
else
    HOST_TOOLS_DCC_FLAGS += -J"using bool DEBUG = false;" -O2
endif

INSTALL_FAT_BOOT_FILE_DCC_FLAGS := \
									$(HOST_TOOLS_DCC_FLAGS) \
									-I"$(INSTALL_FAT_BOOT_FILE_SRC_ROOT)" \
									--depfile "$(INSTALL_FAT_BOOT_FILE_DEP)" \
									--compdb-entry "$(INSTALL_FAT_BOOT_FILE_COMPDB)"

$(eINSTALL_FAT_BOOT_FILE) $(eINSTALL_FAT_BOOT_FILE_COMPDB): $(eINSTALL_FAT_BOOT_FILE_DC_ENTRY)
	@$(CMD_MKDIR_P) "$(HOST_TOOLS_WORK_ROOT)"
	@$(call CMD_DCC,$<,$(INSTALL_FAT_BOOT_FILE),$(INSTALL_FAT_BOOT_FILE_DCC_FLAGS))
ifeq ($(HOST),Linux)
	@chmod +x "$(INSTALL_FAT_BOOT_FILE)"
endif

-include $(eINSTALL_FAT_BOOT_FILE_DEP)

CMD_INSTALL_FAT_BOOT_FILE = \
        "$(INSTALL_FAT_BOOT_FILE)" \
            -Image "$(1)" \
            -Source "$(2)"

.PHONY: host-tools

host-tools: $(eINSTALL_FAT_BOOT_FILE)

export HOST_TOOLS_WORK_ROOT

export INSTALL_FAT_BOOT_FILE CMD_INSTALL_FAT_BOOT_FILE
