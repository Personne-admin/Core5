BOOTLOADER_ROOT				:= $(ABS_ROOT)$(PATH_SEPARATOR)Boot Loader
BOOTLOADER_STAGE1_SOURCE	:= $(BOOTLOADER_ROOT)$(PATH_SEPARATOR)Boot Sector.asm
BOOTLOADER_STAGE2_ROOT		:= $(BOOTLOADER_ROOT)$(PATH_SEPARATOR)Stage 2 Source
BOOTLOADER_STAGE2_SOURCE	:= $(BOOTLOADER_STAGE2_ROOT)$(PATH_SEPARATOR)Main.asm
BOOTLOADER_STAGE2_DC_ENTRY	:= $(BOOTLOADER_STAGE2_ROOT)$(PATH_SEPARATOR)Main.dc

BOOTLOADER_OUTPUT_ROOT		:= $(WORK_ROOT)$(PATH_SEPARATOR)Boot Loader
BOOTLOADER_STAGE1			:= $(BOOTLOADER_OUTPUT_ROOT)$(PATH_SEPARATOR)Boot Sector
BOOTLOADER_STAGE2			:= $(BOOTLOADER_OUTPUT_ROOT)$(PATH_SEPARATOR)Core5 Boot Loader
BOOTLOADER_GENERATED_ASM	:= $(BOOTLOADER_OUTPUT_ROOT)$(PATH_SEPARATOR)Generated Assembler
BOOTLOADER_STAGE2_DC_ASM	:= $(BOOTLOADER_GENERATED_ASM)$(PATH_SEPARATOR)DC Code.asm
BOOTLOADER_STAGE2_DC_DEP	:= $(BOOTLOADER_GENERATED_ASM)$(PATH_SEPARATOR)DC Code.d
BOOTLOADER_STAGE2_COMPDB	:= $(BOOTLOADER_GENERATED_ASM)$(PATH_SEPARATOR)DC Code.compdb.json

eBOOTLOADER_STAGE1_SOURCE	:= $(call escape_path,$(BOOTLOADER_STAGE1_SOURCE))
eBOOTLOADER_STAGE2_SOURCE	:= $(call escape_path,$(BOOTLOADER_STAGE2_SOURCE))
eBOOTLOADER_STAGE2_DC_ENTRY	:= $(call escape_path,$(BOOTLOADER_STAGE2_DC_ENTRY))
eBOOTLOADER_STAGE1			:= $(call escape_path,$(BOOTLOADER_STAGE1))
eBOOTLOADER_STAGE2			:= $(call escape_path,$(BOOTLOADER_STAGE2))
eBOOTLOADER_GENERATED_ASM	:= $(call escape_path,$(BOOTLOADER_GENERATED_ASM))
eBOOTLOADER_STAGE2_DC_ASM	:= $(call escape_path,$(BOOTLOADER_STAGE2_DC_ASM))
eBOOTLOADER_STAGE2_DC_DEP	:= $(call escape_path,$(BOOTLOADER_STAGE2_DC_DEP))
eBOOTLOADER_STAGE2_COMPDB	:= $(call escape_path,$(BOOTLOADER_STAGE2_COMPDB))

eCOMPDB_ENTRIES				+= $(eBOOTLOADER_STAGE2_COMPDB)

BOOTLOADER_STAGE2_LOAD_ADDRESS	:= 0x500

BOOTLOADER_STAGE2_DCC_FLAGS := \
								-fbackend custom \
								-target i8086-binary \
								-mcmodel unreal \
								-fbase 0x0:$(BOOTLOADER_STAGE2_LOAD_ADDRESS) \
								-fpartial-eval \
								-fno-stack-protector \
								-fwhole-program \
								-e loader_entry \
								-fno-stack-probe \
								-I"$(BOOTLOADER_STAGE2_ROOT)" \
								--depfile "$(BOOTLOADER_STAGE2_DC_DEP)" \
								--compdb-entry "$(BOOTLOADER_STAGE2_COMPDB)"

ifeq ($(CONFIG),Debug)
	BOOTLOADER_STAGE2_DCC_FLAGS += -fbounds-check -frestricted-check -J"using bool DEBUG = true;"
else
	BOOTLOADER_STAGE2_DCC_FLAGS += -J"using bool DEBUG = false;" -O2
endif

ifeq ($(HOST),Linux)
	OBJCOPY ?= objcopy
	GDB_SYMBOL_BUILDER := $(BUILDSYSTEM_ROOT)$(PATH_SEPARATOR)Configuration Scripts$(PATH_SEPARATOR)Make GDB Symbols.sh
	BOOTLOADER_STAGE1_SYMBOLS := $(BOOTLOADER_STAGE1).sym
	BOOTLOADER_STAGE2_SYMBOLS := $(BOOTLOADER_STAGE2).sym
	eGDB_SYMBOL_BUILDER := $(call escape_path,$(GDB_SYMBOL_BUILDER))
	eBOOTLOADER_STAGE1_SYMBOLS := $(call escape_path,$(BOOTLOADER_STAGE1_SYMBOLS))
	eBOOTLOADER_STAGE2_SYMBOLS := $(call escape_path,$(BOOTLOADER_STAGE2_SYMBOLS))
endif

eBOOTLOADER_STAGE2_SOURCES := $(eBOOTLOADER_STAGE2_SOURCE) \
								$(call escape_path,$(BOOTLOADER_STAGE2_ROOT)$(PATH_SEPARATOR)Cpu.asm) \
								$(call escape_path,$(BOOTLOADER_STAGE2_ROOT)$(PATH_SEPARATOR)Unreal.asm)

$(eBOOTLOADER_STAGE1): $(eBOOTLOADER_STAGE1_SOURCE) $(eBOOTLOADER_STAGE2) $(eFASMG_PRELUDE_SOURCES)
	@$(CMD_MKDIR_P) "$(BOOTLOADER_OUTPUT_ROOT)"
	@$(call CMD_FASMG,$<,$@,-i "define Stage2Path '$(BOOTLOADER_STAGE2)'")

$(eBOOTLOADER_STAGE2_DC_ASM) $(eBOOTLOADER_STAGE2_COMPDB): $(eBOOTLOADER_STAGE2_DC_ENTRY)
	@$(CMD_MKDIR_P) "$(BOOTLOADER_GENERATED_ASM)"
	@$(call CMD_DCC_ASM,$<,$@,$(BOOTLOADER_STAGE2_DCC_FLAGS))

$(eBOOTLOADER_STAGE2): $(eBOOTLOADER_STAGE2_SOURCES) $(eBOOTLOADER_STAGE2_DC_ASM) $(eFASMG_PRELUDE_SOURCES)
	@$(CMD_MKDIR_P) "$(BOOTLOADER_OUTPUT_ROOT)"
	@INCLUDE="$(BOOTLOADER_GENERATED_ASM);$(ASSEMBLY_ROOT)" $(call CMD_FASMG,$<,$@)

-include $(eBOOTLOADER_STAGE2_DC_DEP)

ifeq ($(HOST),Linux)
$(eBOOTLOADER_STAGE1_SYMBOLS): $(eBOOTLOADER_STAGE1) $(eGDB_SYMBOL_BUILDER)
	@"$(GDB_SYMBOL_BUILDER)" "$(OBJCOPY)" "$<" "$<.lst" "$@" 0x7C00

$(eBOOTLOADER_STAGE2_SYMBOLS): $(eBOOTLOADER_STAGE2) $(eGDB_SYMBOL_BUILDER)
	@"$(GDB_SYMBOL_BUILDER)" "$(OBJCOPY)" "$<" "$<.lst" "$@" $(BOOTLOADER_STAGE2_LOAD_ADDRESS)

bootloader: $(eBOOTLOADER_STAGE1_SYMBOLS) $(eBOOTLOADER_STAGE2_SYMBOLS)
endif

export BOOTLOADER_ROOT BOOTLOADER_STAGE2_ROOT
export BOOTLOADER_STAGE1 BOOTLOADER_STAGE2
export BOOTLOADER_STAGE1_SYMBOLS BOOTLOADER_STAGE2_SYMBOLS
export BOOTLOADER_STAGE2_LOAD_ADDRESS
