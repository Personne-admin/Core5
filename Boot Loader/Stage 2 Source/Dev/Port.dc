module Dev::Port;

///
/// The address in a Port I/O
/// address space range of ISA.
///
@nominal
public using Port = u16;

using public Dev::Port = Port;

public void out(T)(u16 port, T value) {
    asm @[intel, inputs(p in dx = port, v in accumulator = value)] { "out %[p], %[v]" };
}

public T in(T)(u16 port) {
    T value;
    asm @[intel, output(value in accumulator), inputs(p in dx = port)] { "in %[value], %[p]" };
    return value;
}

public void io_wait() {
    asm @[intel] { "out 0x80, al" };
}
